{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdedleopard.github.io/connector-risk-framework/schema/changes.schema.json",
  "title": "Weekly change set",
  "description": "data/changes/{date}.json: connectors added, removed or changed in one refresh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "new",
    "removed",
    "changed",
    "names"
  ],
  "properties": {
    "date": {
      "$ref": "#/$defs/date"
    },
    "new": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string"
          }
        }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
