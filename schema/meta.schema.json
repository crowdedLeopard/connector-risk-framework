{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdedleopard.github.io/connector-risk-framework/schema/meta.schema.json",
  "title": "Catalogue metadata",
  "description": "data/current/meta.json: refresh date, counts and classifier measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataDate",
    "counts",
    "parseFailures",
    "classifier",
    "categories"
  ],
  "properties": {
    "dataDate": {
      "$ref": "#/$defs/date"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": [
        "catalogue",
        "records",
        "operations",
        "operationsWithCall",
        "withOperations",
        "withAuthDocumented",
        "withCategories",
        "withDefinition"
      ]
    },
    "parseFailures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classifier": {
      "type": "object",
      "required": [
        "agree",
        "comparable",
        "operationsTested",
        "byClass",
        "unclassifiedByWords",
        "deleteMethodFoundByWords",
        "deleteMethodOperations"
      ],
      "properties": {
        "byClass": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "agree",
              "total"
            ],
            "properties": {
              "agree": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        },
        "sampleDisagreements": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
