{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdedleopard.github.io/connector-risk-framework/schema/facts.schema.json",
  "title": "Governance facts",
  "description": "data/current/facts.json: each statement about Microsoft behaviour, its source and whether its evidence was found on the last check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checked",
    "facts",
    "sources",
    "fetchErrors"
  ],
  "properties": {
    "checked": {
      "$ref": "#/$defs/date"
    },
    "fetchErrors": {},
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "source",
          "status",
          "lastChecked",
          "missing"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lastChecked": {
            "$ref": "#/$defs/date"
          },
          "missing": {
            "type": "array"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
